{
  "name": "@peter.naydenov/signals",
  "description": "Signals",
  "version": "1.5.1",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "src/main.js",
  "types": "./types/main.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/main.d.ts",
        "default": "./src/main.js"
      },
      "require": {
        "types": "./types/main.d.cts",
        "default": "./dist/signals.cjs"
      },
      "default": "./src/main.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "dist",
    "types",
    "skills",
    "Changelog.md",
    "Migration.guide.md"
  ],
  "engines": {
    "node": ">=17.0.0"
  },
  "type": "module",
  "scripts": {
    "test": "mocha test",
    "test:types": "tsc -p .",
    "cover": "c8 npm test",
    "build": "rollup -c",
    "prepublishOnly": "npm test && npm run test:types && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/signals.git"
  },
  "keywords": [
    "signals"
  ],
  "homepage": "https://github.com/PeterNaydenov/signals#readme",
  "bugs": {
    "url": "https://github.com/PeterNaydenov/signals/issues"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "rollup": "^4.64.5",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.5",
    "brace-expansion": "^5.0.5"
  },
  "c8": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "node_modules",
      "test",
      "test-data"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
